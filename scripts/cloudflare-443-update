#!/bin/bash
set -euo pipefail

DIR=/var/lib/cloudflare-ips
RULES=$DIR/cf_filter.nft
mkdir -p "$DIR"

fetch() {
  local ver=$1 min=$2 tmp
  tmp=$(mktemp)
  if curl -fsS --max-time 20 "https://www.cloudflare.com/ips-$ver" -o "$tmp" \
     && [ "$(grep -c . "$tmp")" -ge "$min" ] \
     && ! grep -qvE '^[0-9a-fA-F:.]+/[0-9]{1,3}$' "$tmp"; then
    install -m 0640 "$tmp" "$DIR/ips-$ver.txt"
  else
    echo "Ogiltig eller uteblivet svar för ips-$ver, använder senast sparade" >&2
  fi
  rm -f "$tmp"
  [ -s "$DIR/ips-$ver.txt" ] || { echo "Inga ranges för $ver" >&2; exit 1; }
}

fetch v4 10
fetch v6 5

V4=$(paste -sd, "$DIR/ips-v4.txt")
V6=$(paste -sd, "$DIR/ips-v6.txt")

cat > "$RULES" << RULESET
table inet cf_filter
delete table inet cf_filter
table inet cf_filter {
  set cf4 { type ipv4_addr; flags interval; elements = { $V4 } }
  set cf6 { type ipv6_addr; flags interval; elements = { $V6 } }
  chain pre {
    type filter hook prerouting priority raw; policy accept;
    iifname != "eth0" return
    tcp dport 443 ip saddr @cf4 return
    tcp dport 443 ip6 saddr @cf6 return
    tcp dport { 80, 443 } counter comment "icke-Cloudflare, tillaten (its1ssl)"
  }
}
RULESET

nft -c -f "$RULES"
nft -f "$RULES"
echo "Cloudflare-filter uppdaterat: $(grep -c . "$DIR/ips-v4.txt") v4, $(grep -c . "$DIR/ips-v6.txt") v6"
